# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# MCP config (contains credentials)
.mcp.json

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# cloudflare (OpenNext のビルド成果物・wrangler のローカル状態)
.open-next
.wrangler
.dev.vars*

# OG 画像用サムネイル（prebuild で scripts/generate-og-thumbs.mjs が生成）
/public/og-thumbs/

# typescript
*.tsbuildinfo
next-env.d.ts

# temp files (screenshots, work images, logs)
/*.png
/*.jpg
/*.html
/logs/
/tmp_images/
/facilities-snapshot.md
/org-detail-snapshot.md
/psi-result.md
/*-snapshot.md
/*-images.json
/facility-page-images.json

# playwright MCP
.playwright-mcp/
