# Cloudflare Workers の静的アセット用ヘッダー
# https://developers.cloudflare.com/workers/static-assets/headers/
# サイトは静的書き出しで、next.config.ts の headers() は効かない。ヘッダーはここで付ける
# （このファイルは Worker が返すレスポンス＝/go/{id} などのリダイレクトには適用されない）

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

# ビルドごとにファイル名が変わるので永続キャッシュしてよい
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# OG 画像は拡張子の無いファイル（opengraph-image）として書き出されるので、Content-Type が付かない。
# 付けないと X や LINE のプレビューで画像が出ないことがある
/opengraph-image
  Content-Type: image/png
/*/opengraph-image
  Content-Type: image/png
