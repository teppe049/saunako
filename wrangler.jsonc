{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "saunako",
	// サイト本体は静的アセット（next build の output: "export" が out/ に書き出す）。
	// Worker は一致するファイルが無いリクエストだけを受ける（/go/{id} など。worker/index.ts）
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "out",
		"binding": "ASSETS",
		// /area/tokyo → out/area/tokyo.html。末尾スラッシュ付きはスラッシュ無しへ転送される
		"html_handling": "auto-trailing-slash",
		// 存在しないパスは out/404.html を 404 で返す
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	}
}
