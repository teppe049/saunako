{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "saunako",
	// saunako.jp のゾーンがある個人アカウント（My Account）。環境変数 CLOUDFLARE_API_TOKEN は
	// 株式会社SaunaTrip のトークンなので、これを書いておかないと会社アカウントにデプロイされてしまう
	// （docs/cloudflare-api-token-setup.md）
	"account_id": "e125443b737b2ebdfc1779a7fbd28588",
	// サイト本体は静的アセット（next build の output: "export" が out/ に書き出す）。
	// Worker は一致するファイルが無いリクエストだけを受ける（/go/{id} など。worker/index.ts）
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "out",
		"binding": "ASSETS",
		// /area/tokyo → out/area/tokyo.html。末尾スラッシュ付きはスラッシュ無しへ転送される
		"html_handling": "auto-trailing-slash",
		// 存在しないパスは out/404.html を 404 で返す
		"not_found_handling": "404-page",
		// 404-page を指定していると、ブラウザの画面遷移（Sec-Fetch-Mode: navigate）は一致するファイルが無くても
		// Worker に届かず 404.html が返る。Worker で処理するパスはここで Worker を先に通す
		"run_worker_first": ["/go/*", "/pick/*"]
	},
	"observability": {
		"enabled": true
	}
}
